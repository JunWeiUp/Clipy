<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Selected preset: dark fill + near-white border, like the system
         clock's highlighted preset pill. -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#2D2D2D" />
            <stroke android:width="1dp" android:color="#F2F2F2" />
            <corners android:radius="21dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <stroke android:width="1dp" android:color="#808080" />
            <corners android:radius="21dp" />
        </shape>
    </item>
</selector>
