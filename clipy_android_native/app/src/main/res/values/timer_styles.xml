<resources>
    <style name="TimerPanelTheme" parent="@android:style/Theme.Black.NoTitleBar.Fullscreen">
        <item name="android:windowBackground">#000000</item>
        <item name="android:windowIsTranslucent">false</item>
    </style>
    <style name="TimerPreset">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">42dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">5dp</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/timer_preset_bg</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/timer_preset_text</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
</resources>
