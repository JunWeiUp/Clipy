[Unit]
Description=Clipy authenticated relay
After=network-online.target
[Service]
User=clipy-relay
Group=clipy-relay
Environment=PYTHONPATH=/opt/clipy-relay/vendor
ExecStart=/usr/bin/python3 /opt/clipy-relay/server.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
MemoryMax=160M
TasksMax=32
CPUQuota=50%
LimitNOFILE=256
[Install]
WantedBy=multi-user.target
